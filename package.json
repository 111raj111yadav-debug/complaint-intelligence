{
  "name": "complaint-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent Customer Complaint Analysis and Automatic Resolution Recommendation",
  "workspaces": [
    "apps/*",
    "services/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:nlp": "python -m uvicorn app.main:app --app-dir services/nlp --host 0.0.0.0 --port 8000 --reload",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=services/api",
    "build": "npm run build:api && npm run build:web",
    "test:web": "npm run test --workspace=apps/web",
    "test:api": "npm run test --workspace=services/api",
    "test:nlp": "python -m pytest services/nlp/tests -v",
    "test:integration": "vitest run tests/integration.test.ts",
    "test": "npm run test:api && npm run test:web",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:api": "npm run lint --workspace=services/api",
    "lint:nlp": "ruff check services/nlp",
    "lint": "npm run lint:api && npm run lint:web",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:index": "python services/nlp/scripts/build_vector_index.py",
    "db:index:force": "python services/nlp/scripts/build_vector_index.py --force",
    "eval:retrieval": "python services/nlp/scripts/evaluate_retrieval.py",
    "db:studio": "npx prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "prettier": "^3.5.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
