# ==============================================================================
# Intelligent Customer Complaint Analysis and Automatic Resolution Recommendation
# Root Environment Configuration Template
# NOTE: Copy this file to .env and adjust values for local development.
# NEVER commit the real .env file with secrets to version control.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
ENVIRONMENT=development

# Frontend Configuration
WEB_PORT=3000
VITE_API_URL=http://localhost:5000/api/v1

# Node.js Express Application API
API_PORT=5000
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Python FastAPI NLP Microservice
NLP_SERVICE_URL=http://localhost:8000
NLP_HOST=0.0.0.0
NLP_PORT=8000
NLP_TIMEOUT_SECONDS=10

# Database Configuration (PostgreSQL with pgvector)
# Exposed port 5434 on host to avoid conflict with standard PostgreSQL 5432
POSTGRES_USER=complaint_admin
POSTGRES_PASSWORD=complaint_secure_dev_pass_2026
POSTGRES_DB=complaint_intelligence_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Prisma Database Connection URL
DATABASE_URL=postgresql://complaint_admin:complaint_secure_dev_pass_2026@localhost:5434/complaint_intelligence_db?schema=public

# Phase 3 Security & Authentication
JWT_SECRET=change_this_to_a_secure_random_secret_at_least_32_chars_in_prod
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Optional / Future LLM & Embedding Configurations (Phase 2+)
# Set placeholder tokens - these are not required in Phase 0
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
LLM_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
